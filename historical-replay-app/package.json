{
  "name": "port-operations-monorepo",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "test": "npm run test --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "typecheck": "npm run typecheck --workspace frontend",
    "demo": "node scripts/demo.mjs",
    "demo:reset": "node scripts/demo.mjs --reset --prepare-only",
    "real:download": "backend/.venv/Scripts/python.exe backend/scripts/download_real_data.py",
    "real:prepare": "backend/.venv/Scripts/python.exe backend/scripts/prepare_ais_data.py",
    "real:replay": "backend/.venv/Scripts/python.exe backend/scripts/run_historical_replay.py",
    "real:evaluate": "backend/.venv/Scripts/python.exe backend/scripts/evaluate_replay.py"
  }
}
